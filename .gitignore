# ── MARK LV — Git Ignore ──────────────────────────────────────────

# Secrets and Credentials
config/api_keys.json
config/telegram.json
config/certs/
config/whatsapp_web/
**/token*.json
**/client_secret*.json
*credentials*.json
.env
.env.*

# Old backups / reference folders
Jarvis MK/

# Personal data / runtime database & memory
memory/long_term.json
memory/*.db
memory/*.json
!memory/__init__.py

# Python build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Editors and OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Runtime output
*.log
logs/
downloads/
screenshots/
